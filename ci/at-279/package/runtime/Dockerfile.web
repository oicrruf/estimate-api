FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
WORKDIR /build
COPY sources/app/package.json sources/app/package-lock.json ./
RUN --mount=type=secret,id=build_ca,required=false sh -ec 'if [ -f /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi; npm ci --ignore-scripts --no-audit --no-fund'
COPY sources/app/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6
USER root
COPY --from=build /build/dist/estimate-app/browser/ /usr/share/nginx/html/
COPY runtime/nginx.conf /etc/nginx/conf.d/default.conf
RUN chmod -R a+rX /usr/share/nginx/html && chmod 0644 /etc/nginx/conf.d/default.conf
USER 101:101
EXPOSE 8080
