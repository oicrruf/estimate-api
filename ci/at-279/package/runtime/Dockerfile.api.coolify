FROM ghcr.io/astral-sh/uv:0.7.6@sha256:c467e9b5da1e763ee5841f9ae51020d11569ca08991a05367ceca6eda0be9b16 AS uvtool

FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e AS source
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
RUN git init --quiet \
    && git remote add origin https://github.com/oicrruf/estimate-api.git \
    && git fetch --quiet --no-tags --depth 1 origin dac8c64c314bb362c6254825c65640ba732ca168 \
    && test "$(git rev-parse FETCH_HEAD)" = dac8c64c314bb362c6254825c65640ba732ca168 \
    && git archive FETCH_HEAD | tar -x

FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e AS build
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
WORKDIR /app
COPY --from=uvtool /uv /usr/local/bin/uv
COPY --from=source /source/pyproject.toml /source/uv.lock ./
COPY --from=source /source/src ./src
COPY --from=source /source/demo ./demo
RUN uv sync --frozen --extra demo --no-dev

FROM python:3.12.14-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin demo \
    && mkdir /data \
    && chown 10001:10001 /data
COPY --from=build /app/.venv /app/.venv
COPY --from=source /source/src ./src
COPY --from=source /source/demo ./demo
COPY container_api.py container_seed.py ./
RUN chmod -R a+rX /app/.venv /app/src /app/demo /app/container_api.py /app/container_seed.py
USER 10001:10001
EXPOSE 8001
CMD ["/app/.venv/bin/python", "/app/container_api.py"]
