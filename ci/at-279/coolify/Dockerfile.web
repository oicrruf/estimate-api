FROM node:24.22.3-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
RUN apk add --no-cache git ca-certificates
WORKDIR /source
RUN git init --quiet \
    && git remote add origin https://github.com/oicrruf/estimate-app.git \
    && git fetch --quiet --no-tags --depth 1 origin d8a6d359bf909872ebfe48d52dfe5d8980c2c68b \
    && test "$(git rev-parse FETCH_HEAD)" = d8a6d359bf909872ebfe48d52dfe5d8980c2c68b \
    && git archive FETCH_HEAD | tar -x
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm run build

FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6
USER root
COPY --from=build /source/dist/estimate-app/browser/ /usr/share/nginx/html/
COPY package/runtime/nginx.conf /etc/nginx/conf.d/default.conf
RUN chmod -R a+rX /usr/share/nginx/html \
    && chmod 0644 /etc/nginx/conf.d/default.conf
USER 101:101
EXPOSE 8080
