# API bootstrap needs no external credentials.
# AT-209 backend-only local read configuration; leave unset for health checks.
ESTIMATE_SUPABASE_AUTH_ISSUER=<trusted-auth-issuer-url>
ESTIMATE_SUPABASE_AUTH_AUDIENCE=authenticated
ESTIMATE_INTERACTIVE_ALLOWED_SUBJECTS=[]
ESTIMATE_DB_READ_DSN=<backend-only-read-login-dsn>
# The preview remains unavailable in the product app without an injected extractor.
ESTIMATE_PREVIEW_LOCAL_ENABLED=0
# Future backend-only integration placeholders.
OPENAI_API_KEY=<set-in-runtime-secret-store-when-ADK-is-implemented>
SUPABASE_URL=<set-when-supabase-integration-is-implemented>
SUPABASE_SECRET_KEY=<set-in-runtime-secret-store-when-needed>
DATABASE_URL=<set-in-runtime-secret-store-when-needed>
MCP_AUTH_CONFIG=<set-when-mcp-auth-is-implemented>
RELATE_DATA_DIR=<set-when-relate-is-implemented>
