SUPABASE_URL=<set-when-supabase-integration-is-implemented>
SUPABASE_SECRET_KEY=<set-in-runtime-secret-store-when-needed>
DATABASE_URL=<set-in-runtime-secret-store-when-needed>
MCP_AUTH_CONFIG=<set-when-mcp-auth-is-implemented>
RELATE_DATA_DIR=<set-when-relate-is-implemented>
