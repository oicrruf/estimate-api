{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estimate.example/schema/project-document.v1.schema.json",
  "title": "Estimate Agent project document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "entities", "packages"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "$ref": "#/$defs/id" },
    "entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entity" } },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)+$" },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "origin", "scope", "revision", "knowledgeState"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["ProjectGoal", "Requirement", "Capability", "Resource", "Task", "Deliverable", "Constraint", "SiteCondition", "Evidence", "Dependency", "BOMLine", "Rule", "Approval"] },
        "label": { "type": "string", "minLength": 1 },
        "origin": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "ref"],
          "properties": {
            "kind": { "enum": ["user", "document", "agent", "system"] },
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["project", "site", "area", "workstream"] },
            "id": { "$ref": "#/$defs/id" }
          }
        },
        "revision": { "type": "integer", "minimum": 1 },
        "knowledgeState": { "enum": ["known", "assumed", "unknown", "conflicted"] },
        "relations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["predicate", "targetId"],
            "properties": {
              "predicate": { "type": "string", "minLength": 1 },
              "targetId": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "namespace", "version", "subjectId", "facts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
        "subjectId": { "$ref": "#/$defs/id" },
        "facts": { "type": "object" }
      }
    }
  }
}
