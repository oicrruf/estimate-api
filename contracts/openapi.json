{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "PreviewProposal": {
        "properties": {
          "availableQuantity": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Availablequantity"
          },
          "status": {
            "enum": [
              "insufficient_stock",
              "needs_review"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "PreviewProposal",
        "type": "object"
      },
      "PreviewRequest": {
        "properties": {
          "brief": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Brief",
            "type": "string"
          }
        },
        "required": [
          "brief"
        ],
        "title": "PreviewRequest",
        "type": "object"
      },
      "PreviewResponse": {
        "properties": {
          "commercialReady": {
            "const": false,
            "default": false,
            "title": "Commercialready",
            "type": "boolean"
          },
          "evidenceIds": {
            "items": {
              "type": "string"
            },
            "title": "Evidenceids",
            "type": "array"
          },
          "persisted": {
            "const": false,
            "default": false,
            "title": "Persisted",
            "type": "boolean"
          },
          "projectId": {
            "format": "uuid",
            "title": "Projectid",
            "type": "string"
          },
          "proposal": {
            "$ref": "#/components/schemas/PreviewProposal"
          },
          "question": {
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "requestedQuantity": {
            "minimum": 1.0,
            "title": "Requestedquantity",
            "type": "integer"
          },
          "reviewRequired": {
            "const": true,
            "default": true,
            "title": "Reviewrequired",
            "type": "boolean"
          },
          "schemaVersion": {
            "const": "scope-review-preview.v1",
            "default": "scope-review-preview.v1",
            "title": "Schemaversion",
            "type": "string"
          },
          "state": {
            "const": "pending_review",
            "default": "pending_review",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "requestedQuantity",
          "question",
          "evidenceIds",
          "proposal",
          "projectId"
        ],
        "title": "PreviewResponse",
        "type": "object"
      },
      "ProjectPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProjectView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "ProjectPage",
        "type": "object"
      },
      "ProjectView": {
        "properties": {
          "access_role": {
            "enum": [
              "owner",
              "editor",
              "viewer"
            ],
            "title": "Access Role",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "revision",
          "access_role"
        ],
        "title": "ProjectView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Supabase Auth access token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Versioned bootstrap contract for Estimate Agent.",
    "title": "Estimate Agent API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the API process is responding.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/projects": {
      "get": {
        "operationId": "listProjects",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid or missing Bearer token"
          },
          "403": {
            "description": "Interactive access denied"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Authentication or storage unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Projects",
        "tags": [
          "projects"
        ]
      }
    },
    "/projects/{project_id}": {
      "get": {
        "operationId": "getProject",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Project Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectView"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Invalid or missing Bearer token"
          },
          "403": {
            "description": "Interactive access denied"
          },
          "404": {
            "description": "Project not found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "Authentication or storage unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Project",
        "tags": [
          "projects"
        ]
      }
    },
    "/v1/projects/{projectId}/scope-review-preview": {
      "post": {
        "operationId": "previewScopeReviewV1",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Projectid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Actor is not admitted or cannot edit this project"
          },
          "404": {
            "description": "Project not found"
          },
          "409": {
            "description": "Preview already reserved"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Preview quota reached"
          },
          "503": {
            "description": "Preview unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Preview Scope Review",
        "tags": [
          "projects"
        ]
      }
    }
  }
}
