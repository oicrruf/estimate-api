MERGE (n:CAPABILITY {id: "REQ-NVR:channelsMin"}) SET n += {id: "REQ-NVR:channelsMin", key: "channelsMin", value: 4, role: "required"};
MATCH (a:REQUIREMENT {id: "REQ-NVR"}), (b:CAPABILITY {id: "REQ-NVR:channelsMin"}) MERGE (a)-[:REQUIRES]->(b);
MERGE (n:REQUIREMENT {id: "REQ-UPS-SMOKE"}) SET n += {id: "REQ-UPS-SMOKE", domain: "power", name: "UPS de al menos 1000 VA", quantity: 1};
MERGE (n:CAPABILITY {id: "REQ-UPS-SMOKE:capacityVaMin"}) SET n += {id: "REQ-UPS-SMOKE:capacityVaMin", key: "capacityVaMin", value: 1000, role: "required"};
MATCH (a:REQUIREMENT {id: "REQ-UPS-SMOKE"}), (b:CAPABILITY {id: "REQ-UPS-SMOKE:capacityVaMin"}) MERGE (a)-[:REQUIRES]->(b);
MERGE (n:EVIDENCE {id: "EV-SW8"}) SET n += {id: "EV-SW8", source: "ficha técnica ficticia SW-8", datasetId: "estimate-hackathon-v1"};
MERGE (n:EVIDENCE {id: "EV-SW16"}) SET n += {id: "EV-SW16", source: "ficha técnica ficticia SW-16", datasetId: "estimate-hackathon-v1"};
