// DATOS Y PRECIOS FICTICIOS. Ejecutar en base local vacía o de demostración.
// Idempotente para los IDs estimate-hackathon-v1; no borra otros datos.
CREATE CONSTRAINT requirement_id IF NOT EXISTS FOR (n:REQUIREMENT) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT product_id IF NOT EXISTS FOR (n:PRODUCT) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT capability_id IF NOT EXISTS FOR (n:CAPABILITY) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT offer_id IF NOT EXISTS FOR (n:OFFER) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT evidence_id IF NOT EXISTS FOR (n:EVIDENCE) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT accessory_id IF NOT EXISTS FOR (n:ACCESSORY) REQUIRE n.id IS UNIQUE;
MERGE (n:REQUIREMENT {id: "REQ-SWITCH"}) SET n += {id: "REQ-SWITCH", domain: "network", name: "Switch para ocho cámaras PoE y uplink separado", quantity: 1};
MERGE (n:CAPABILITY {id: "REQ-SWITCH:poePortsMin"}) SET n += {id: "REQ-SWITCH:poePortsMin", key: "poePortsMin", value: 8, role: "required"};
MATCH (a:REQUIREMENT {id: "REQ-SWITCH"}), (b:CAPABILITY {id: "REQ-SWITCH:poePortsMin"}) MERGE (a)-[:REQUIRES]->(b);
MERGE (n:CAPABILITY {id: "REQ-SWITCH:distinctUplinkPorts"}) SET n += {id: "REQ-SWITCH:distinctUplinkPorts", key: "distinctUplinkPorts", value: 1, role: "required"};
MATCH (a:REQUIREMENT {id: "REQ-SWITCH"}), (b:CAPABILITY {id: "REQ-SWITCH:distinctUplinkPorts"}) MERGE (a)-[:REQUIRES]->(b);
MERGE (n:CAPABILITY {id: "REQ-SWITCH:totalPortsMin"}) SET n += {id: "REQ-SWITCH:totalPortsMin", key: "totalPortsMin", value: 9, role: "required"};
MATCH (a:REQUIREMENT {id: "REQ-SWITCH"}), (b:CAPABILITY {id: "REQ-SWITCH:totalPortsMin"}) MERGE (a)-[:REQUIRES]->(b);
MERGE (n:CAPABILITY {id: "REQ-SWITCH:poeBudgetWMin"}) SET n += {id: "REQ-SWITCH:poeBudgetWMin", key: "poeBudgetWMin", value: 48, role: "required"};
MATCH (a:REQUIREMENT {id: "REQ-SWITCH"}), (b:CAPABILITY {id: "REQ-SWITCH:poeBudgetWMin"}) MERGE (a)-[:REQUIRES]->(b);
MERGE (n:REQUIREMENT {id: "REQ-CAMERA"}) SET n += {id: "REQ-CAMERA", domain: "network", name: "Cuatro cámaras de 4 MP con alimentación PoE", quantity: 4};
MERGE (n:CAPABILITY {id: "REQ-CAMERA:resolutionMpMin"}) SET n += {id: "REQ-CAMERA:resolutionMpMin", key: "resolutionMpMin", value: 4, role: "required"};
MATCH (a:REQUIREMENT {id: "REQ-CAMERA"}), (b:CAPABILITY {id: "REQ-CAMERA:resolutionMpMin"}) MERGE (a)-[:REQUIRES]->(b);
MERGE (n:CAPABILITY {id: "REQ-CAMERA:power"}) SET n += {id: "REQ-CAMERA:power", key: "power", value: "PoE", role: "required"};
MATCH (a:REQUIREMENT {id: "REQ-CAMERA"}), (b:CAPABILITY {id: "REQ-CAMERA:power"}) MERGE (a)-[:REQUIRES]->(b);
