MATCH (a:OFFER {id: "OFF-CAM-B"}), (b:PRODUCT {id: "CAM-POE"}) MERGE (a)-[:SELLS]->(b);
MATCH (p:PRODUCT {id: "SW-8"}), (r:REQUIREMENT {id: "REQ-SWITCH"}) MERGE (p)-[x:INCOMPATIBLE_WITH]->(r) SET x.reasonCode = "TOTAL_PORTS_8_LT_9";
MATCH (p:PRODUCT {id: "CAM-12V"}), (r:REQUIREMENT {id: "REQ-CAMERA"}) MERGE (p)-[x:INCOMPATIBLE_WITH]->(r) SET x.reasonCode = "POWER_NOT_POE";
MATCH (p:PRODUCT {id: "UPS-600"}), (r:REQUIREMENT {id: "REQ-UPS-SMOKE"}) MERGE (p)-[x:INCOMPATIBLE_WITH]->(r) SET x.reasonCode = "CAPACITY_600_LT_1000";
