MERGE (n:OFFER {id: "OFF-SW8"}) SET n += {id: "OFF-SW8", productId: "SW-8", priceUsd: 80, quantity: 5, seller: "Proveedor ficticio A"};
MATCH (a:OFFER {id: "OFF-SW8"}), (b:PRODUCT {id: "SW-8"}) MERGE (a)-[:SELLS]->(b);
MERGE (n:OFFER {id: "OFF-SW16"}) SET n += {id: "OFF-SW16", productId: "SW-16", priceUsd: 160, quantity: 3, seller: "Proveedor ficticio B"};
MATCH (a:OFFER {id: "OFF-SW16"}), (b:PRODUCT {id: "SW-16"}) MERGE (a)-[:SELLS]->(b);
MERGE (n:OFFER {id: "OFF-CAM-A"}) SET n += {id: "OFF-CAM-A", productId: "CAM-POE", priceUsd: 42, quantity: 2, poolId: "POOL-CAM-POE", seller: "Proveedor ficticio A"};
MATCH (a:OFFER {id: "OFF-CAM-A"}), (b:PRODUCT {id: "CAM-POE"}) MERGE (a)-[:SELLS]->(b);
