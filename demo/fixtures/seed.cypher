MERGE (n:PRODUCT {id: "SW-8"}) SET n += {id: "SW-8", kind: "switch", name: "Switch 8 puertos ficticio"};
MERGE (n:CAPABILITY {id: "SW-8:totalPorts"}) SET n += {id: "SW-8:totalPorts", key: "totalPorts", value: 8, role: "measured"};
