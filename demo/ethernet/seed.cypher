// AT-239: dataset ficticio; MERGE sin borrar datos ajenos.
CREATE CONSTRAINT at239_network_link_id IF NOT EXISTS FOR (n:NETWORK_LINK) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_endpoint_id IF NOT EXISTS FOR (n:ENDPOINT) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_port_id IF NOT EXISTS FOR (n:PORT) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_cable_type_id IF NOT EXISTS FOR (n:CABLE_TYPE) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_cable_run_id IF NOT EXISTS FOR (n:CABLE_RUN) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_connector_id IF NOT EXISTS FOR (n:CONNECTOR) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_jack_id IF NOT EXISTS FOR (n:JACK) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_patch_panel_id IF NOT EXISTS FOR (n:PATCH_PANEL) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_patch_cord_id IF NOT EXISTS FOR (n:PATCH_CORD) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_pathway_id IF NOT EXISTS FOR (n:PATHWAY) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_conduit_id IF NOT EXISTS FOR (n:CONDUIT) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_evidence_id IF NOT EXISTS FOR (n:EVIDENCE) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at239_requirement_id IF NOT EXISTS FOR (n:REQUIREMENT) REQUIRE n.id IS UNIQUE;
MERGE (n:ENDPOINT {id: "CAM-1"}) SET n += {datasetId: "at-239-synthetic-v1", medium: "poe_ethernet"};
MERGE (n:EVIDENCE {id: "EV-CAM-1"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_topology"};
MATCH (a:ENDPOINT {id: "CAM-1"}), (b:EVIDENCE {id: "EV-CAM-1"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-INPUT"}]->(b);
MERGE (n:ENDPOINT {id: "CAM-2"}) SET n += {datasetId: "at-239-synthetic-v1", medium: "poe_ethernet"};
MERGE (n:EVIDENCE {id: "EV-CAM-2"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_topology"};
MATCH (a:ENDPOINT {id: "CAM-2"}), (b:EVIDENCE {id: "EV-CAM-2"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-INPUT"}]->(b);
MERGE (n:ENDPOINT {id: "CAM-WIFI"}) SET n += {datasetId: "at-239-synthetic-v1", medium: "wifi_solar"};
MERGE (n:EVIDENCE {id: "EV-CAM-WIFI"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_topology"};
MATCH (a:ENDPOINT {id: "CAM-WIFI"}), (b:EVIDENCE {id: "EV-CAM-WIFI"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-INPUT"}]->(b);
MERGE (n:ENDPOINT {id: "MESH-1"}) SET n += {datasetId: "at-239-synthetic-v1", medium: "mesh"};
MERGE (n:EVIDENCE {id: "EV-MESH-1"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_topology"};
MATCH (a:ENDPOINT {id: "MESH-1"}), (b:EVIDENCE {id: "EV-MESH-1"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-INPUT"}]->(b);
MERGE (n:ENDPOINT {id: "MESH-2"}) SET n += {datasetId: "at-239-synthetic-v1", medium: "mesh"};
MERGE (n:EVIDENCE {id: "EV-MESH-2"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_topology"};
MATCH (a:ENDPOINT {id: "MESH-2"}), (b:EVIDENCE {id: "EV-MESH-2"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-INPUT"}]->(b);
MERGE (n:ENDPOINT {id: "ROUTER"}) SET n += {datasetId: "at-239-synthetic-v1", medium: "wifi_solar"};
MERGE (n:EVIDENCE {id: "EV-ROUTER"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_topology"};
MATCH (a:ENDPOINT {id: "ROUTER"}), (b:EVIDENCE {id: "EV-ROUTER"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-INPUT"}]->(b);
MERGE (n:ENDPOINT {id: "SWITCH"}) SET n += {datasetId: "at-239-synthetic-v1", medium: "switch"};
MERGE (n:PORT {id: "SW-1"}) SET n += {datasetId: "at-239-synthetic-v1", poeCapable: true};
MATCH (a:ENDPOINT {id: "SWITCH"}), (b:PORT {id: "SW-1"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-PORT-OWNER"}]->(b);
MERGE (n:PORT {id: "SW-2"}) SET n += {datasetId: "at-239-synthetic-v1", poeCapable: true};
MATCH (a:ENDPOINT {id: "SWITCH"}), (b:PORT {id: "SW-2"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-PORT-OWNER"}]->(b);
MERGE (n:PORT {id: "SW-3"}) SET n += {datasetId: "at-239-synthetic-v1", poeCapable: false};
MATCH (a:ENDPOINT {id: "SWITCH"}), (b:PORT {id: "SW-3"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-PORT-OWNER"}]->(b);
MERGE (n:PORT {id: "SW-UP"}) SET n += {datasetId: "at-239-synthetic-v1", poeCapable: false};
MATCH (a:ENDPOINT {id: "SWITCH"}), (b:PORT {id: "SW-UP"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-PORT-OWNER"}]->(b);
MERGE (n:PORT {id: "CAM-1-P"}) SET n += {datasetId: "at-239-synthetic-v1", poeCapable: true};
MATCH (a:ENDPOINT {id: "CAM-1"}), (b:PORT {id: "CAM-1-P"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-PORT-OWNER"}]->(b);
MERGE (n:PORT {id: "CAM-2-P"}) SET n += {datasetId: "at-239-synthetic-v1", poeCapable: true};
MATCH (a:ENDPOINT {id: "CAM-2"}), (b:PORT {id: "CAM-2-P"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-PORT-OWNER"}]->(b);
MERGE (n:PORT {id: "MESH-2-P"}) SET n += {datasetId: "at-239-synthetic-v1", poeCapable: false};
MATCH (a:ENDPOINT {id: "MESH-2"}), (b:PORT {id: "MESH-2-P"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-PORT-OWNER"}]->(b);
MERGE (n:PORT {id: "ROUTER-P"}) SET n += {datasetId: "at-239-synthetic-v1", poeCapable: false};
MATCH (a:ENDPOINT {id: "ROUTER"}), (b:PORT {id: "ROUTER-P"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-PORT-OWNER"}]->(b);
MERGE (n:REQUIREMENT {id: "REQ-POE-CABLE"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "poe_cable"};
MERGE (n:REQUIREMENT {id: "REQ-CAT6"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "category"};
MERGE (n:CABLE_TYPE {id: "CAT6-IN"}) SET n += {datasetId: "at-239-synthetic-v1", category: "Cat6", conductor: "solid_copper"};
MERGE (n:EVIDENCE {id: "EV-CAT6-IN"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_catalog"};
MATCH (a:CABLE_TYPE {id: "CAT6-IN"}), (b:EVIDENCE {id: "EV-CAT6-IN"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-CATALOG"}]->(b);
MATCH (a:CABLE_TYPE {id: "CAT6-IN"}), (b:REQUIREMENT {id: "REQ-POE-CABLE"}) MERGE (a)-[:SUPPORTS_POE {ruleId: "RULE-SYNTHETIC-CAPABILITY"}]->(b);
MATCH (a:CABLE_TYPE {id: "CAT6-IN"}), (b:REQUIREMENT {id: "REQ-CAT6"}) MERGE (a)-[:SUPPORTS_STANDARD {ruleId: "RULE-CATALOG-CATEGORY"}]->(b);
MERGE (n:CABLE_TYPE {id: "CAT6-OUT"}) SET n += {datasetId: "at-239-synthetic-v1", category: "Cat6", conductor: "solid_copper"};
MERGE (n:EVIDENCE {id: "EV-CAT6-OUT"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_catalog"};
MATCH (a:CABLE_TYPE {id: "CAT6-OUT"}), (b:EVIDENCE {id: "EV-CAT6-OUT"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-CATALOG"}]->(b);
MATCH (a:CABLE_TYPE {id: "CAT6-OUT"}), (b:REQUIREMENT {id: "REQ-POE-CABLE"}) MERGE (a)-[:SUPPORTS_POE {ruleId: "RULE-SYNTHETIC-CAPABILITY"}]->(b);
MATCH (a:CABLE_TYPE {id: "CAT6-OUT"}), (b:REQUIREMENT {id: "REQ-CAT6"}) MERGE (a)-[:SUPPORTS_STANDARD {ruleId: "RULE-CATALOG-CATEGORY"}]->(b);
MERGE (n:CABLE_TYPE {id: "CAT6-CCA"}) SET n += {datasetId: "at-239-synthetic-v1", category: "Cat6", conductor: "cca"};
MERGE (n:EVIDENCE {id: "EV-CAT6-CCA"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_catalog"};
MATCH (a:CABLE_TYPE {id: "CAT6-CCA"}), (b:EVIDENCE {id: "EV-CAT6-CCA"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-CATALOG"}]->(b);
MATCH (a:CABLE_TYPE {id: "CAT6-CCA"}), (b:REQUIREMENT {id: "REQ-CAT6"}) MERGE (a)-[:SUPPORTS_STANDARD {ruleId: "RULE-CATALOG-CATEGORY"}]->(b);
MERGE (n:JACK {id: "JACK-CAT6-SOLID"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "jack"};
MERGE (n:EVIDENCE {id: "EV-JACK"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_catalog"};
MATCH (a:JACK {id: "JACK-CAT6-SOLID"}), (b:EVIDENCE {id: "EV-JACK"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-CATALOG"}]->(b);
MERGE (n:CONNECTOR {id: "RJ45-CAT6-SOLID"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "connector"};
MERGE (n:EVIDENCE {id: "EV-RJ45"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_catalog"};
MATCH (a:CONNECTOR {id: "RJ45-CAT6-SOLID"}), (b:EVIDENCE {id: "EV-RJ45"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-CATALOG"}]->(b);
MERGE (n:CONNECTOR {id: "RJ45-STRANDED"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "connector"};
MERGE (n:EVIDENCE {id: "EV-RJ45-STRANDED"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_catalog"};
MATCH (a:CONNECTOR {id: "RJ45-STRANDED"}), (b:EVIDENCE {id: "EV-RJ45-STRANDED"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-CATALOG"}]->(b);
MERGE (n:PATHWAY {id: "PATH-EMT-DEMO"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "conduit"};
MERGE (n:CONDUIT {id: "CONDUIT-EMT-DEMO"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "emt"};
MATCH (a:PATHWAY {id: "PATH-EMT-DEMO"}), (b:CONDUIT {id: "CONDUIT-EMT-DEMO"}) MERGE (a)-[:SHARES_PATHWAY {ruleId: "RULE-PATHWAY"}]->(b);
MERGE (n:NETWORK_LINK {id: "LINK-CAM-1"}) SET n += {datasetId: "at-239-synthetic-v1", state: "required"};
MATCH (a:ENDPOINT {id: "CAM-1"}), (b:NETWORK_LINK {id: "LINK-CAM-1"}) MERGE (a)-[:REQUIRES_LINK {ruleId: "RULE-TOPOLOGY"}]->(b);
MATCH (a:NETWORK_LINK {id: "LINK-CAM-1"}), (b:EVIDENCE {id: "EV-CAM-1"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-TOPOLOGY"}]->(b);
MERGE (n:NETWORK_LINK {id: "LINK-CAM-2"}) SET n += {datasetId: "at-239-synthetic-v1", state: "required"};
MATCH (a:ENDPOINT {id: "CAM-2"}), (b:NETWORK_LINK {id: "LINK-CAM-2"}) MERGE (a)-[:REQUIRES_LINK {ruleId: "RULE-TOPOLOGY"}]->(b);
MATCH (a:NETWORK_LINK {id: "LINK-CAM-2"}), (b:EVIDENCE {id: "EV-CAM-2"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-TOPOLOGY"}]->(b);
MERGE (n:NETWORK_LINK {id: "LINK-MESH-2"}) SET n += {datasetId: "at-239-synthetic-v1", state: "required"};
MATCH (a:ENDPOINT {id: "MESH-2"}), (b:NETWORK_LINK {id: "LINK-MESH-2"}) MERGE (a)-[:REQUIRES_LINK {ruleId: "RULE-TOPOLOGY"}]->(b);
MATCH (a:NETWORK_LINK {id: "LINK-MESH-2"}), (b:EVIDENCE {id: "EV-MESH-2"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-TOPOLOGY"}]->(b);
MERGE (n:NETWORK_LINK {id: "LINK-UPLINK"}) SET n += {datasetId: "at-239-synthetic-v1", state: "required"};
MERGE (n:EVIDENCE {id: "EV-UPLINK"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_topology"};
MATCH (a:ENDPOINT {id: "ROUTER"}), (b:NETWORK_LINK {id: "LINK-UPLINK"}) MERGE (a)-[:REQUIRES_LINK {ruleId: "RULE-CONFIRMED-UPLINK"}]->(b);
MATCH (a:NETWORK_LINK {id: "LINK-UPLINK"}), (b:EVIDENCE {id: "EV-UPLINK"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-CONFIRMED-UPLINK"}]->(b);
MERGE (n:CABLE_RUN {id: "LINK-CAM-1"}) SET n += {datasetId: "at-239-synthetic-v1", confirmed: true};
MERGE (n:EVIDENCE {id: "EV-RUN-CAM-1"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_route"};
MATCH (a:NETWORK_LINK {id: "LINK-CAM-1"}), (b:CABLE_RUN {id: "LINK-CAM-1"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-RUN"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-1"}), (b:CABLE_TYPE {id: "CAT6-IN"}) MERGE (a)-[:USES_CABLE {ruleId: "RULE-SELECTED-CABLE"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-1"}), (b:EVIDENCE {id: "EV-RUN-CAM-1"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-ROUTE-INPUT"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-1"}), (b:PORT {id: "SW-1"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-RUN-PORT"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-1"}), (b:PORT {id: "CAM-1-P"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-RUN-PORT"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-1"}), (b:JACK {id: "JACK-CAT6-SOLID"}) MERGE (a)-[:TERMINATES_AT {ruleId: "RULE-TERMINATION"}]->(b);
MATCH (a:NETWORK_LINK {id: "LINK-CAM-1"}), (b:JACK {id: "JACK-CAT6-SOLID"}) MERGE (a)-[:REQUIRES_CONNECTOR {ruleId: "RULE-TERMINATION-DEPENDENCY"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-1"}), (b:CONNECTOR {id: "RJ45-CAT6-SOLID"}) MERGE (a)-[:TERMINATES_AT {ruleId: "RULE-TERMINATION"}]->(b);
MATCH (a:NETWORK_LINK {id: "LINK-CAM-1"}), (b:CONNECTOR {id: "RJ45-CAT6-SOLID"}) MERGE (a)-[:REQUIRES_CONNECTOR {ruleId: "RULE-TERMINATION-DEPENDENCY"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-1"}), (b:PATHWAY {id: "PATH-EMT-DEMO"}) MERGE (a)-[:ROUTED_THROUGH {ruleId: "RULE-CONFIRMED-PATHWAY"}]->(b);
MERGE (n:CABLE_RUN {id: "LINK-CAM-2"}) SET n += {datasetId: "at-239-synthetic-v1", confirmed: false};
MERGE (n:EVIDENCE {id: "EV-RUN-CAM-2"}) SET n += {datasetId: "at-239-synthetic-v1", kind: "synthetic_route"};
MATCH (a:NETWORK_LINK {id: "LINK-CAM-2"}), (b:CABLE_RUN {id: "LINK-CAM-2"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-RUN"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-2"}), (b:CABLE_TYPE {id: "CAT6-IN"}) MERGE (a)-[:USES_CABLE {ruleId: "RULE-SELECTED-CABLE"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-2"}), (b:EVIDENCE {id: "EV-RUN-CAM-2"}) MERGE (a)-[:SUPPORTED_BY {ruleId: "RULE-ROUTE-INPUT"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-2"}), (b:PORT {id: "SW-2"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-RUN-PORT"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-2"}), (b:PORT {id: "CAM-2-P"}) MERGE (a)-[:CONNECTS_TO {ruleId: "RULE-RUN-PORT"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-2"}), (b:JACK {id: "JACK-CAT6-SOLID"}) MERGE (a)-[:TERMINATES_AT {ruleId: "RULE-TERMINATION"}]->(b);
MATCH (a:NETWORK_LINK {id: "LINK-CAM-2"}), (b:JACK {id: "JACK-CAT6-SOLID"}) MERGE (a)-[:REQUIRES_CONNECTOR {ruleId: "RULE-TERMINATION-DEPENDENCY"}]->(b);
MATCH (a:CABLE_RUN {id: "LINK-CAM-2"}), (b:CONNECTOR {id: "RJ45-CAT6-SOLID"}) MERGE (a)-[:TERMINATES_AT {ruleId: "RULE-TERMINATION"}]->(b);
MATCH (a:NETWORK_LINK {id: "LINK-CAM-2"}), (b:CONNECTOR {id: "RJ45-CAT6-SOLID"}) MERGE (a)-[:REQUIRES_CONNECTOR {ruleId: "RULE-TERMINATION-DEPENDENCY"}]->(b);
