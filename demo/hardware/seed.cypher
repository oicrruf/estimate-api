// Grafo ficticio AT-238. MERGE por ID; sin borrado de otros datos.
CREATE CONSTRAINT at238_installation_segment_id IF NOT EXISTS FOR (n:INSTALLATION_SEGMENT) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at238_material_id IF NOT EXISTS FOR (n:MATERIAL) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at238_accessory_id IF NOT EXISTS FOR (n:ACCESSORY) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at238_enclosure_id IF NOT EXISTS FOR (n:ENCLOSURE) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at238_requirement_id IF NOT EXISTS FOR (n:REQUIREMENT) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at238_spec_id IF NOT EXISTS FOR (n:SPEC) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT at238_evidence_id IF NOT EXISTS FOR (n:EVIDENCE) REQUIRE n.id IS UNIQUE;
MERGE (n:INSTALLATION_SEGMENT {id: "SEG-DEMO"}) SET n += {id: "SEG-DEMO", datasetId: "at-238-synthetic-v1"};
MERGE (n:EVIDENCE {id: "EV-ROUTE-CONFIRMED"}) SET n += {id: "EV-ROUTE-CONFIRMED", kind: "synthetic_route_input"};
MATCH (a:INSTALLATION_SEGMENT {id: "SEG-DEMO"}), (b:EVIDENCE {id: "EV-ROUTE-CONFIRMED"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CONFIRMED-INPUT"}]->(b);
MERGE (n:INSTALLATION_SEGMENT {id: "SEG-UNKNOWN"}) SET n += {id: "SEG-UNKNOWN", datasetId: "at-238-synthetic-v1"};
MERGE (n:EVIDENCE {id: "EV-ROUTE-UNKNOWN"}) SET n += {id: "EV-ROUTE-UNKNOWN", kind: "synthetic_route_input"};
MATCH (a:INSTALLATION_SEGMENT {id: "SEG-UNKNOWN"}), (b:EVIDENCE {id: "EV-ROUTE-UNKNOWN"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CONFIRMED-INPUT"}]->(b);
MERGE (n:ENCLOSURE {id: "BOX-DEMO"}) SET n += {id: "BOX-DEMO", kind: "generic_box"};
MERGE (n:REQUIREMENT {id: "REQ-DEMO-COUPLING"}) SET n += {id: "REQ-DEMO-COUPLING", family: "coupling"};
MATCH (a:INSTALLATION_SEGMENT {id: "SEG-DEMO"}), (b:REQUIREMENT {id: "REQ-DEMO-COUPLING"}) MERGE (a)-[r:REQUIRES {ruleId: "RULE-CONFIRMED-COUPLING"}]->(b);
MATCH (a:REQUIREMENT {id: "REQ-DEMO-COUPLING"}), (b:EVIDENCE {id: "EV-ROUTE-CONFIRMED"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CONFIRMED-INPUT"}]->(b);
MERGE (n:REQUIREMENT {id: "REQ-DEMO-CONNECTOR"}) SET n += {id: "REQ-DEMO-CONNECTOR", family: "connector"};
MATCH (a:INSTALLATION_SEGMENT {id: "SEG-DEMO"}), (b:REQUIREMENT {id: "REQ-DEMO-CONNECTOR"}) MERGE (a)-[r:REQUIRES {ruleId: "RULE-CONFIRMED-CONNECTOR"}]->(b);
MATCH (a:REQUIREMENT {id: "REQ-DEMO-CONNECTOR"}), (b:EVIDENCE {id: "EV-ROUTE-CONFIRMED"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CONFIRMED-INPUT"}]->(b);
MERGE (n:REQUIREMENT {id: "REQ-DEMO-SUPPORT"}) SET n += {id: "REQ-DEMO-SUPPORT", family: "support"};
MATCH (a:INSTALLATION_SEGMENT {id: "SEG-DEMO"}), (b:REQUIREMENT {id: "REQ-DEMO-SUPPORT"}) MERGE (a)-[r:REQUIRES {ruleId: "RULE-CONFIRMED-SUPPORT"}]->(b);
MATCH (a:REQUIREMENT {id: "REQ-DEMO-SUPPORT"}), (b:EVIDENCE {id: "EV-ROUTE-CONFIRMED"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CONFIRMED-INPUT"}]->(b);
MERGE (n:SPEC {id: "SPEC-DIAMETER-1"}) SET n += {id: "SPEC-DIAMETER-1", diameter: "1"};
MERGE (n:MATERIAL {id: "GEN-EMT-1"}) SET n += {id: "GEN-EMT-1", family: "emt", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-EMT-1"}) SET n += {id: "EV-CAT-EMT-1", kind: "synthetic_catalog_record"};
MATCH (a:MATERIAL {id: "GEN-EMT-1"}), (b:SPEC {id: "SPEC-DIAMETER-1"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:MATERIAL {id: "GEN-EMT-1"}), (b:EVIDENCE {id: "EV-CAT-EMT-1"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:ACCESSORY {id: "GEN-COUPLING-1"}) SET n += {id: "GEN-COUPLING-1", family: "coupling", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-COUPLING-1"}) SET n += {id: "EV-CAT-COUPLING-1", kind: "synthetic_catalog_record"};
MATCH (a:ACCESSORY {id: "GEN-COUPLING-1"}), (b:SPEC {id: "SPEC-DIAMETER-1"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-COUPLING-1"}), (b:EVIDENCE {id: "EV-CAT-COUPLING-1"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:ACCESSORY {id: "GEN-CONNECTOR-1"}) SET n += {id: "GEN-CONNECTOR-1", family: "connector", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-CONNECTOR-1"}) SET n += {id: "EV-CAT-CONNECTOR-1", kind: "synthetic_catalog_record"};
MATCH (a:ACCESSORY {id: "GEN-CONNECTOR-1"}), (b:SPEC {id: "SPEC-DIAMETER-1"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-CONNECTOR-1"}), (b:EVIDENCE {id: "EV-CAT-CONNECTOR-1"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:ACCESSORY {id: "GEN-SUPPORT-1"}) SET n += {id: "GEN-SUPPORT-1", family: "support", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-SUPPORT-1"}) SET n += {id: "EV-CAT-SUPPORT-1", kind: "synthetic_catalog_record"};
MATCH (a:ACCESSORY {id: "GEN-SUPPORT-1"}), (b:SPEC {id: "SPEC-DIAMETER-1"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-SUPPORT-1"}), (b:EVIDENCE {id: "EV-CAT-SUPPORT-1"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:ACCESSORY {id: "GEN-LB-1"}) SET n += {id: "GEN-LB-1", family: "lb", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-LB-1"}) SET n += {id: "EV-CAT-LB-1", kind: "synthetic_catalog_record"};
MATCH (a:ACCESSORY {id: "GEN-LB-1"}), (b:SPEC {id: "SPEC-DIAMETER-1"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-LB-1"}), (b:EVIDENCE {id: "EV-CAT-LB-1"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:SPEC {id: "SPEC-DIAMETER-3-4"}) SET n += {id: "SPEC-DIAMETER-3-4", diameter: "3/4"};
MERGE (n:MATERIAL {id: "GEN-EMT-3-4"}) SET n += {id: "GEN-EMT-3-4", family: "emt", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-EMT-3-4"}) SET n += {id: "EV-CAT-EMT-3-4", kind: "synthetic_catalog_record"};
MATCH (a:MATERIAL {id: "GEN-EMT-3-4"}), (b:SPEC {id: "SPEC-DIAMETER-3-4"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:MATERIAL {id: "GEN-EMT-3-4"}), (b:EVIDENCE {id: "EV-CAT-EMT-3-4"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:ACCESSORY {id: "GEN-COUPLING-3-4"}) SET n += {id: "GEN-COUPLING-3-4", family: "coupling", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-COUPLING-3-4"}) SET n += {id: "EV-CAT-COUPLING-3-4", kind: "synthetic_catalog_record"};
MATCH (a:ACCESSORY {id: "GEN-COUPLING-3-4"}), (b:SPEC {id: "SPEC-DIAMETER-3-4"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-COUPLING-3-4"}), (b:EVIDENCE {id: "EV-CAT-COUPLING-3-4"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:ACCESSORY {id: "GEN-CONNECTOR-3-4"}) SET n += {id: "GEN-CONNECTOR-3-4", family: "connector", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-CONNECTOR-3-4"}) SET n += {id: "EV-CAT-CONNECTOR-3-4", kind: "synthetic_catalog_record"};
MATCH (a:ACCESSORY {id: "GEN-CONNECTOR-3-4"}), (b:SPEC {id: "SPEC-DIAMETER-3-4"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-CONNECTOR-3-4"}), (b:EVIDENCE {id: "EV-CAT-CONNECTOR-3-4"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:ACCESSORY {id: "GEN-SUPPORT-3-4"}) SET n += {id: "GEN-SUPPORT-3-4", family: "support", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-SUPPORT-3-4"}) SET n += {id: "EV-CAT-SUPPORT-3-4", kind: "synthetic_catalog_record"};
MATCH (a:ACCESSORY {id: "GEN-SUPPORT-3-4"}), (b:SPEC {id: "SPEC-DIAMETER-3-4"}) MERGE (a)-[r:FITS_DIAMETER {ruleId: "RULE-CATALOG-DIAMETER"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-SUPPORT-3-4"}), (b:EVIDENCE {id: "EV-CAT-SUPPORT-3-4"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MERGE (n:ACCESSORY {id: "GEN-OUTLET"}) SET n += {id: "GEN-OUTLET", family: "outlet", kind: "generic_type"};
MERGE (n:EVIDENCE {id: "EV-CAT-OUTLET"}) SET n += {id: "EV-CAT-OUTLET", kind: "synthetic_catalog_record"};
MATCH (a:ACCESSORY {id: "GEN-OUTLET"}), (b:EVIDENCE {id: "EV-CAT-OUTLET"}) MERGE (a)-[r:SUPPORTED_BY {ruleId: "RULE-CATALOG-EVIDENCE"}]->(b);
MATCH (a:INSTALLATION_SEGMENT {id: "SEG-DEMO"}), (b:ENCLOSURE {id: "BOX-DEMO"}) MERGE (a)-[r:CONNECTS_TO {ruleId: "RULE-CONFIRMED-ENTRIES"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-CONNECTOR-1"}), (b:ENCLOSURE {id: "BOX-DEMO"}) MERGE (a)-[r:CONNECTS_TO {ruleId: "RULE-CATALOG-CONNECTOR"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-SUPPORT-1"}), (b:INSTALLATION_SEGMENT {id: "SEG-DEMO"}) MERGE (a)-[r:MOUNTS_TO {ruleId: "RULE-CATALOG-SUPPORT"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-CONNECTOR-3-4"}), (b:ENCLOSURE {id: "BOX-DEMO"}) MERGE (a)-[r:CONNECTS_TO {ruleId: "RULE-CATALOG-CONNECTOR"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-SUPPORT-3-4"}), (b:INSTALLATION_SEGMENT {id: "SEG-DEMO"}) MERGE (a)-[r:MOUNTS_TO {ruleId: "RULE-CATALOG-SUPPORT"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-COUPLING-1"}), (b:ACCESSORY {id: "GEN-COUPLING-3-4"}) MERGE (a)-[r:ALTERNATIVE_TO {ruleId: "RULE-DIAMETER-ALTERNATIVE"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-CONNECTOR-1"}), (b:ACCESSORY {id: "GEN-CONNECTOR-3-4"}) MERGE (a)-[r:ALTERNATIVE_TO {ruleId: "RULE-DIAMETER-ALTERNATIVE"}]->(b);
MATCH (a:ACCESSORY {id: "GEN-SUPPORT-1"}), (b:ACCESSORY {id: "GEN-SUPPORT-3-4"}) MERGE (a)-[r:ALTERNATIVE_TO {ruleId: "RULE-DIAMETER-ALTERNATIVE"}]->(b);
